---
// src/components/DiagramLightbox.astro
// Universal Fullscreen Lightbox with Zoom & Pan for Mermaid Diagrams & Post Images
---

<div id="diagram-lightbox-modal" class="diagram-lightbox-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
  
  <div class="lightbox-container">
    <!-- Top Floating Toolbar -->
    <header class="lightbox-toolbar">
      <div class="lightbox-info">
        <span class="lightbox-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Interactive Inspector
        </span>
        <span class="lightbox-title" id="lightbox-title">Diagram View</span>
      </div>

      <div class="lightbox-controls">
        <span class="lightbox-zoom-readout" id="lightbox-zoom-readout">100%</span>
        
        <button type="button" class="lightbox-btn" id="lightbox-zoom-out" title="Zoom Out (-)" aria-label="Zoom out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>

        <button type="button" class="lightbox-btn reset-btn" id="lightbox-zoom-reset" title="Reset Zoom (1:1)" aria-label="Reset zoom">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
          <span>Fit</span>
        </button>

        <button type="button" class="lightbox-btn" id="lightbox-zoom-in" title="Zoom In (+)" aria-label="Zoom in">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>

        <div class="lightbox-divider"></div>

        <button type="button" class="lightbox-btn close-btn" id="lightbox-close" title="Close (Esc)" aria-label="Close inspector">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Canvas Stage for Panning & Zooming -->
    <main class="lightbox-stage" id="lightbox-stage">
      <div class="lightbox-canvas" id="lightbox-canvas">
        <!-- Injected diagram SVG or Image -->
      </div>
    </main>

    <!-- Bottom Shortcut Guide -->
    <footer class="lightbox-footer">
      <span class="shortcut-item"><kbd>Scroll</kbd> Zoom</span>
      <span class="shortcut-dot">•</span>
      <span class="shortcut-item"><kbd>Drag</kbd> Pan</span>
      <span class="shortcut-dot">•</span>
      <span class="shortcut-item"><kbd>Double-Click</kbd> Toggle 2x</span>
      <span class="shortcut-dot">•</span>
      <span class="shortcut-item"><kbd>Esc</kbd> Exit</span>
    </footer>
  </div>
</div>

<script>
  // Self-contained Lightbox Manager
  class DiagramLightboxManager {
    constructor() {
      this.modal = document.getElementById('diagram-lightbox-modal');
      this.stage = document.getElementById('lightbox-stage');
      this.canvas = document.getElementById('lightbox-canvas');
      this.titleEl = document.getElementById('lightbox-title');
      this.readout = document.getElementById('lightbox-zoom-readout');
      this.backdrop = document.getElementById('lightbox-backdrop');
      this.closeBtn = document.getElementById('lightbox-close');
      this.zoomInBtn = document.getElementById('lightbox-zoom-in');
      this.zoomOutBtn = document.getElementById('lightbox-zoom-out');
      this.resetBtn = document.getElementById('lightbox-zoom-reset');

      this.scale = 1;
      this.panX = 0;
      this.panY = 0;
      this.isDragging = false;
      this.startX = 0;
      this.startY = 0;
      this.isOpen = false;
      this.initialTouchDistance = null;

      if (!this.modal) return;
      this.bindEvents();
    }

    bindEvents() {
      // Close triggers
      this.closeBtn?.addEventListener('click', () => this.close());
      this.backdrop?.addEventListener('click', () => this.close());

      // Zoom triggers
      this.zoomInBtn?.addEventListener('click', () => this.zoomBy(1.25));
      this.zoomOutBtn?.addEventListener('click', () => this.zoomBy(0.8));
      this.resetBtn?.addEventListener('click', () => this.resetZoom());

      // Keyboard
      window.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;
        if (e.key === 'Escape') this.close();
        if (e.key === '+' || e.key === '=') this.zoomBy(1.2);
        if (e.key === '-' || e.key === '_') this.zoomBy(0.83);
        if (e.key === '0' || e.key === 'r') this.resetZoom();
      });

      // Mouse Wheel Zoom centered on cursor
      this.stage?.addEventListener('wheel', (e) => {
        if (!this.isOpen) return;
        e.preventDefault();

        const zoomFactor = e.deltaY < 0 ? 1.15 : 0.87;
        const rect = this.stage.getBoundingClientRect();
        const cursorX = e.clientX - rect.left - rect.width / 2;
        const cursorY = e.clientY - rect.top - rect.height / 2;

        const newScale = Math.min(Math.max(this.scale * zoomFactor, 0.35), 6.0);
        const actualFactor = newScale / this.scale;

        // Adjust pan to keep point under cursor fixed
        this.panX = cursorX - (cursorX - this.panX) * actualFactor;
        this.panY = cursorY - (cursorY - this.panY) * actualFactor;
        this.scale = newScale;

        this.updateTransform();
      }, { passive: false });

      // Mouse Drag Pan
      this.stage?.addEventListener('mousedown', (e) => {
        if (!this.isOpen || e.button !== 0) return;
        this.isDragging = true;
        this.startX = e.clientX - this.panX;
        this.startY = e.clientY - this.panY;
        this.stage.classList.add('is-panning');
      });

      window.addEventListener('mousemove', (e) => {
        if (!this.isDragging || !this.isOpen) return;
        this.panX = e.clientX - this.startX;
        this.panY = e.clientY - this.startY;
        this.updateTransform();
      });

      window.addEventListener('mouseup', () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.stage?.classList.remove('is-panning');
      });

      // Double-Click to toggle zoom
      this.stage?.addEventListener('dblclick', (e) => {
        if (!this.isOpen) return;
        e.preventDefault();
        if (this.scale > 1.2) {
          this.resetZoom();
        } else {
          const rect = this.stage.getBoundingClientRect();
          const cursorX = e.clientX - rect.left - rect.width / 2;
          const cursorY = e.clientY - rect.top - rect.height / 2;
          this.scale = 2.0;
          this.panX = -cursorX * 0.75;
          this.panY = -cursorY * 0.75;
          this.updateTransform();
        }
      });

      // Mobile Touch Handling (Pinch-to-zoom & single-finger drag)
      this.stage?.addEventListener('touchstart', (e) => {
        if (!this.isOpen) return;
        if (e.touches.length === 1) {
          this.isDragging = true;
          this.startX = e.touches[0].clientX - this.panX;
          this.startY = e.touches[0].clientY - this.panY;
        } else if (e.touches.length === 2) {
          this.isDragging = false;
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          this.initialTouchDistance = Math.hypot(dx, dy);
        }
      }, { passive: true });

      this.stage?.addEventListener('touchmove', (e) => {
        if (!this.isOpen) return;
        if (e.touches.length === 1 && this.isDragging) {
          e.preventDefault();
          this.panX = e.touches[0].clientX - this.startX;
          this.panY = e.touches[0].clientY - this.startY;
          this.updateTransform();
        } else if (e.touches.length === 2 && this.initialTouchDistance) {
          e.preventDefault();
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          const currentDistance = Math.hypot(dx, dy);
          const factor = currentDistance / this.initialTouchDistance;
          this.scale = Math.min(Math.max(this.scale * factor, 0.4), 6.0);
          this.initialTouchDistance = currentDistance;
          this.updateTransform();
        }
      }, { passive: false });

      this.stage?.addEventListener('touchend', () => {
        this.isDragging = false;
        this.initialTouchDistance = null;
      });
    }

    open(sourceEl, title = 'Interactive Diagram') {
      if (!this.modal || !this.canvas) return;

      this.canvas.innerHTML = '';
      if (this.titleEl) {
        this.titleEl.textContent = title;
      }

      if (sourceEl instanceof SVGElement) {
        const clone = sourceEl.cloneNode(true);
        // Clear layout constraining inline styles
        clone.style.maxWidth = 'none';
        clone.style.maxHeight = 'none';
        clone.style.width = 'auto';
        clone.style.height = 'auto';
        clone.style.display = 'block';
        clone.removeAttribute('id');
        this.canvas.appendChild(clone);
      } else if (sourceEl instanceof HTMLImageElement) {
        const img = document.createElement('img');
        img.src = sourceEl.src;
        img.alt = sourceEl.alt || 'Zoomed Image';
        img.style.maxWidth = 'none';
        img.style.maxHeight = 'none';
        img.style.display = 'block';
        img.style.borderRadius = '8px';
        this.canvas.appendChild(img);
      } else {
        const clone = sourceEl.cloneNode(true);
        this.canvas.appendChild(clone);
      }

      this.resetZoom();
      this.modal.classList.add('active');
      this.modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      this.isOpen = true;
    }

    close() {
      if (!this.modal) return;
      this.modal.classList.remove('active');
      this.modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      this.isOpen = false;
      setTimeout(() => {
        if (!this.isOpen && this.canvas) {
          this.canvas.innerHTML = '';
        }
      }, 250);
    }

    zoomBy(factor) {
      this.scale = Math.min(Math.max(this.scale * factor, 0.35), 6.0);
      this.updateTransform();
    }

    resetZoom() {
      this.scale = 1.0;
      this.panX = 0;
      this.panY = 0;
      this.updateTransform();
    }

    updateTransform() {
      if (!this.canvas) return;
      this.canvas.style.transform = `translate(${this.panX}px, ${this.panY}px) scale(${this.scale})`;
      if (this.readout) {
        this.readout.textContent = `${Math.round(this.scale * 100)}%`;
      }
    }
  }

  // Export globally for page integration
  function initLightbox() {
    window.__diagramLightbox = new DiagramLightboxManager();
  }

  if (typeof window !== 'undefined') {
    initLightbox();
    document.addEventListener('astro:after-swap', initLightbox);
  }
</script>

<style>
  .diagram-lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease-out;
  }
  .diagram-lightbox-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 8, 14, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .lightbox-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  /* Top Toolbar */
  .lightbox-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background: rgba(13, 16, 26, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lightbox-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lightbox-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  .lightbox-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lightbox-zoom-readout {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    min-width: 52px;
    text-align: center;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    height: 34px;
    padding: 0 0.6rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    transform: translateY(-1px);
  }
  .lightbox-btn.reset-btn {
    padding: 0 0.75rem;
  }
  .lightbox-divider {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.12);
    margin: 0 0.3rem;
  }
  .lightbox-btn.close-btn {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.3);
    color: #fca5a5;
    padding: 0 0.65rem;
  }
  .lightbox-btn.close-btn:hover {
    background: rgba(239, 68, 68, 0.35);
    color: #fff;
  }

  /* Stage Canvas */
  .lightbox-stage {
    flex: 1;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }
  .lightbox-stage.is-panning {
    cursor: grabbing;
  }

  .lightbox-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    transition: transform 0.06s cubic-bezier(0.2, 0, 0, 1);
    will-change: transform;
    padding: 2rem;
  }

  .lightbox-canvas :global(svg) {
    max-width: none !important;
    max-height: none !important;
    width: auto !important;
    height: auto !important;
    filter: drop-shadow(0 12px 36px rgba(0, 0, 0, 0.5));
  }

  .lightbox-canvas :global(img) {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
  }

  /* Bottom Footer */
  .lightbox-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    background: rgba(13, 16, 26, 0.8);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    font-size: 0.78rem;
    backdrop-filter: blur(8px);
  }
  .shortcut-item kbd {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--text);
  }
  .shortcut-dot {
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .lightbox-toolbar { padding: 0.6rem 1rem; }
    .lightbox-title { display: none; }
    .lightbox-footer { display: none; }
    .lightbox-zoom-readout { min-width: 44px; font-size: 0.75rem; }
  }
</style>
