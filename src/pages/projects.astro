---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PROJECTS, PROJECT_CATEGORY_LABELS } from '../consts';
import type { ProjectCategory } from '../consts';

// Group projects by category
const grouped = Object.entries(PROJECT_CATEGORY_LABELS).map(([key, label]) => ({
  key: key as ProjectCategory,
  label,
  projects: PROJECTS.filter(p => p.category === key),
})).filter(g => g.projects.length > 0);
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <BaseHead title={`Projects | ${SITE_TITLE}`} description="Open source projects, developer tools, and architecture reference code." />
</head>
<body>
  <Header />
  <main class="container">
    <section class="page-header">
      <h1>Projects & Codebases</h1>
      <p>Curated open-source projects, high-performance libraries, systems protocols, and live documentation hubs.</p>
    </section>

    {grouped.map(group => (
      <section class="project-group">
        <h2 class="group-title">{group.label}</h2>
        <div class="projects-grid">
          {group.projects.map(project => (
            <div class="project-card">
              <div class="project-card-header">
                <h3 class="project-title">{project.title}</h3>
                <span class="project-category-badge">{group.label.split(' ')[0]}</span>
              </div>
              <p class="project-desc">{project.description}</p>
              <div class="project-tags">
                {project.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              <div class="project-card-footer">
                <a href={project.url} target="_blank" rel="noopener" class="project-btn project-btn-primary">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                  </svg>
                  <span>Code ↗</span>
                </a>
                {project.docs && (
                  <a href={project.docs} target="_blank" rel="noopener" class="project-btn project-btn-docs">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                    <span>Docs ↗</span>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer />
</body>
</html>

<style>
  .page-header {
    background: var(--hero-gradient);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem;
    margin: 2rem 0 2.5rem;
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
    max-width: 620px;
  }
  .project-group {
    margin-bottom: 3rem;
  }
  .group-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: all 0.2s ease;
    height: 100%;
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .project-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .project-category-badge {
    font-size: 1rem;
    line-height: 1;
  }
  .project-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex: 1;
  }
  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  .project-card-footer {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }
  .project-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .project-btn-primary {
    background: var(--bg-secondary);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .project-btn-primary:hover {
    background: var(--accent-dim);
    color: var(--accent);
    border-color: var(--accent);
  }
  .project-btn-docs {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .project-btn-docs:hover {
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 768px) {
    .page-header { padding: 1.75rem 1.25rem; }
    .page-header h1 { font-size: 1.6rem; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
